# Handle line endings automatically for files detected as text
* text=auto

# Java sources and Gradle files use LF
*.java text eol=lf
*.gradle text eol=lf
*.properties text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Windows batch files use CRLF
*.bat text eol=crlf

# Gradle wrapper
gradlew text eol=lf
